{
  "name": "blogs3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check --write --unsafe",
    "format": "biome format --write",
    "db:schema": "psql \"$DATABASE_URL\" -f schema.sql",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:app": "vitest run --project app",
    "test:build": "next build && vitest run --project build",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "@clerk/nextjs": "^7.10.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@tanstack/react-query": "^5.108.0",
    "@vercel/blob": "^2.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "mcp-handler": "^2.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
