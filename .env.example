# Local database (docker compose up -d)
# Generate a local password:
#   export LOCAL_DB_PASSWORD="$(openssl rand -hex 16)"
#   printf 'DATABASE_URL=postgres://postgres:%s@db.localtest.me:5432/main\n' "$LOCAL_DB_PASSWORD" >> .env.local
DATABASE_URL=postgres://postgres:change-me@db.localtest.me:5432/main

# Clerk authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Vercel Blob for image uploads (https://vercel.com/dashboard/stores)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Admin access (comma or whitespace separated)
# If both are empty: any signed-in user is an admin in local/preview, and nobody is in production.
ADMIN_EMAILS=you@example.com
ADMIN_USER_IDS=

# MCP server OAuth client allowlist (comma or whitespace separated, or * for any client)
# If unset: any client is accepted in local/preview, and none in production.
MCP_ALLOWED_OAUTH_CLIENT_IDS=*

# Optional: off | log | enforce (defaults to log in production, off elsewhere)
MCP_TOKEN_AUDIENCE=

# Optional: canonical site origin when not using Vercel's production domain
NEXT_PUBLIC_SITE_URL=
